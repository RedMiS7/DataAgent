# 这个文件是可选的：默认配置可以直接启动，API Key 在网页上填写。
# 需要覆盖默认值时，复制为 .env 再修改。网页保存的 Key 优先于这里的值。

APP_ENV=local
APP_PORT=8000
AS_OF_DATE=2026-10-31

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# The agent connects to the masked `safe` schema, never to `shop` directly.
MYSQL_BUSINESS_DB=safe
# 业务库的 SQL 方言，按 sqlglot 的名字写，例如 mysql、postgres。
SQL_DIALECT=mysql
MYSQL_APP_DB=dataagent
# Password must match data/initdb/03_grants.sql, or update both together.
MYSQL_RO_USER=shop_ro
MYSQL_RO_PASSWORD=dataagent_ro_pwd
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=change_me_root

QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION_PREFIX=dataagent

# 大模型：DeepSeek（OpenAI 兼容）。
# 留空 LLM_ENDPOINT / LLM_MODEL 时使用内置预设：https://api.deepseek.com/v1 + deepseek-chat。
# 换回华为云 MaaS 时改为 LLM_PROVIDER=maas，并填写 LLM_ENDPOINT 与 LLM_MODEL。
LLM_PROVIDER=deepseek
LLM_ENDPOINT=
LLM_MODEL=
LLM_API_KEY=
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=90
# 单次模型调用最多输出的 token 数。太小会把长 SQL 截断；deepseek-chat 最大 8192。
LLM_MAX_TOKENS=8192
# 一个问题的总时限（秒）。超时后展示已经查到的数据，没有数据时说明原因。
ASK_TIMEOUT_SECONDS=120
ANALYSIS_TIMEOUT_SECONDS=180

# Embedding：阿里云百炼千问（OpenAI 兼容模式）。
# 留空时使用内置预设：https://dashscope.aliyuncs.com/compatible-mode/v1 + text-embedding-v3（1024 维，单批最多 10 条）。
# 改用其他模型时同步修改 EMBEDDING_DIM，并在切换后全量重建索引。
EMBEDDING_PROVIDER=qwen
EMBEDDING_ENDPOINT=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10

# 检索表时用的重排模型（阿里云百炼）。留空 RERANK_API_KEY 时用 EMBEDDING_API_KEY；RERANK_PROVIDER=off 关闭重排。
RERANK_PROVIDER=qwen
RERANK_ENDPOINT=
RERANK_MODEL=
RERANK_API_KEY=
RERANK_TIMEOUT_SECONDS=5
# 交给重排模型的候选表数，以及一次检索最多选几张表。
RERANK_CANDIDATES=20
SEARCH_TOP_TABLES=5

# 后端日志级别：DEBUG 会额外打印每条成功的 SQL。
LOG_LEVEL=INFO

# 提示词里表结构的 token 预算。不超过时放全部表，超过时只放问题需要的表。按模型上下文的一半左右设定。
SCHEMA_TOKEN_BUDGET=32000

RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.35

SQL_MAX_ROWS=500
SQL_TIMEOUT_MS=15000
SQL_MAX_RETRY=3
EMPTY_MAX_RETRY=1
# DABench 实例的设置，和 .env 一起使用。docker-compose.yml 里的 app-dabench 服务已经写好了这些值；
# 在本机直接跑后端时，把下面几行加到环境变量里。
# 先导入数据：python -m app.semantic.cli import_dataset --manifest data/dabench/manifest.json
MYSQL_BUSINESS_DB=dabench
MYSQL_APP_DB=dataagent_dabench
QDRANT_COLLECTION_PREFIX=dabench
SEMANTIC_SEED=seed_dabench
GENERATE_DEMO_DATA=false
